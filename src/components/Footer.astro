---
import { AUTHOR, LINKS } from '../consts';

const links = [
	{ href: LINKS.github, label: 'GitHub ↗', external: true },
	{ href: LINKS.x, label: 'X ↗', external: true },
	{ href: '/rss.xml', label: 'RSS', external: false },
].filter((l) => l.href);
---

<footer class="container">
	<section class="links">
		<span class="display">どこかで会いましょう</span>
		<div>
			{links.map((l) => (
				<a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
			))}
		</div>
	</section>
	<p class="copy">© {AUTHOR}</p>
</footer>

<style>
	footer {
		padding-top: 16px;
		padding-bottom: 48px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 12px 24px;
		padding: 20px 24px 20px 32px;
		border-radius: var(--radius-card);
		background: var(--ink);
		color: #fff;
	}
	.links span {
		font-size: 17px;
		font-weight: 700;
	}
	.links div {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 18px;
		border-radius: 999px;
		background: var(--blue);
		color: var(--ink);
		font-size: 14px;
		font-weight: 700;
	}
	.links a:hover {
		background: #fff;
	}
	.copy {
		margin: 12px 8px 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}
</style>
