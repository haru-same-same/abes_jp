---
import { SITE_TITLE } from '../consts';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
	{ href: '/blog/', label: 'ブログ', active: path.startsWith('/blog') },
	{ href: '/about/', label: 'プロフィール', active: path.startsWith('/about') },
];
---

<header class="container">
	<a href="/" class="brand">
		<Logo />
		{SITE_TITLE}
	</a>
	<nav aria-label="メイン">
		{nav.map((item) => (
			<a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
		))}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding-top: 32px;
		padding-bottom: 32px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 21px;
	}
	nav {
		display: flex;
		gap: 28px;
		font-size: 15px;
		font-weight: 500;
	}
	nav a {
		color: var(--muted);
		padding: 8px 0;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--ink);
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--peach);
		text-decoration-thickness: 3px;
		text-underline-offset: 8px;
	}
</style>
