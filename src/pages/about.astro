---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, SITE_TITLE } from '../consts';
import { profile } from '../data/profile';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`プロフィール | ${SITE_TITLE}`} description={`${AUTHOR} のプロフィール`} />
	</head>
	<body>
		<Header />
		<main class="container">
			<article class="card">
				<p class="label">プロフィール</p>
				<h1 class="display">{AUTHOR}</h1>
				<p class="lead">{profile.role}。{profile.bio}</p>
				<div class="prose">
					<h2>経歴</h2>
					<p>[ここに経歴を書く]</p>
					<h2>興味のあること</h2>
					<ul>
						{profile.interests.map((t) => <li>{t}</li>)}
					</ul>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	article {
		max-width: 820px;
		margin: 0 auto;
		padding: clamp(24px, 6vw, 64px);
	}
	h1 {
		margin: 4px 0 12px;
		font-size: clamp(36px, 6vw, 52px);
		font-weight: 900;
		line-height: 1.2;
	}
	.lead {
		margin: 0 0 8px;
		font-size: 18px;
		color: var(--ink-soft);
	}
</style>
